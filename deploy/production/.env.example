# 公网域名（不要写 http:// 或 https://）；DNS 的 A/AAAA 记录须指向本服务器。
DOMAIN=demo.example.com
CADDY_EMAIL=ops@example.com

# 请使用 URL 安全字符（字母、数字、-、_）且长度不低于 20 位的随机密码。
POSTGRES_DB=grainbin
POSTGRES_USER=grainbin
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
MINIO_ROOT_USER=grainbin-minio
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=grainbin

# 仅供固定管理员登录。首次部署会创建；再次部署不会覆盖密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_REAL_NAME=系统管理员
ADMIN_EMAIL=admin@example.com

# 至少 32 位随机字符串，例如：openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-secret

# 必须与 DOMAIN 一致；保持 JSON 数组格式。
CORS_ORIGINS=["https://demo.example.com"]
